{
  "openapi": "3.0.4",
  "info": {
    "title": "ExternalGiftCards",
    "version": "v1"
  },
  "paths": {
    "/v1/{tenantId}/{client}/giftcard": {
      "get": {
        "tags": [
          "externalgiftcards"
        ],
        "summary": "Returns the external gift card detail.",
        "description": "The provider URL is read from p_server (key VERFIY) for the given client, then the\r\nexternal provider is called with the gift card id.",
        "parameters": [
          {
            "name": "client",
            "in": "path",
            "description": "Firma mandant.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "description": "Gift card identifier.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Gift card detail.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/GiftCardDetailDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiftCardDetailDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/GiftCardDetailDto"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid client / id, or unknown tenant.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Provider URL not configured, or gift card not found at the provider.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Configured provider URL is invalid.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error."
          },
          "502": {
            "description": "Provider error, timeout or unreachable."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GiftCardDetailDto": {
        "type": "object",
        "additionalProperties": { }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      }
    }
  }
}